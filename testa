TEST_FILE="$HOME/AutoVehicle/morai_ws/src/experimental/curvature_speed_purepursuit/test/test_adaptive_node.py"

python3 - "$TEST_FILE" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
lines = path.read_text().splitlines(keepends=True)
fixed = []

for line in lines:
    content = line.lstrip(" \t")
    if content.startswith("ros.get_time.side_effect = lambda: self.now"):
        line = "        " + content
    elif content.startswith("path.header.stamp = NS(to_sec=lambda: self.now)"):
        line = "        " + content
    fixed.append(line)

path.write_text("".join(fixed))
PY

python3 -m py_compile "$TEST_FILE"


