sudo docker start morai-highway-gpu
sudo docker exec -it morai-highway-gpu bash

2. Docker 내부 터미널 — 작업 폴더 이동
cd /root/morai_completion_full

5. Docker 내부 터미널 — 주행 실행

cd /root/morai_completion_full

UBUNTU_IP=192.168.0.10 \
MORAI_IP=192.168.0.1 \
bash RUN.sh \
  bind_ip:=0.0.0.0 \
  ego_status_port:=9099 \
  control_remote_port:=9093 \
  control_source_port:=9094 \
  max_speed_kph:=20.0 \
  stopline_approach_speed_kph:=10.0 \
  highway_cruise_kph:=54.0 \
  highway_max_speed_kph:=79.2 \
  stopline_hold_distance_m:=10.0


  python3 - <<'PY'
from pathlib import Path
import shutil
import ast

p = Path("/root/morai_completion_full/src/control/turn_signal_controller/scripts/maneuver_fusion_node.py")
s = p.read_text()

if "'signal_independent_right'" in s:
    print("이미 적용된 상태입니다.")
    raise SystemExit(0)

start = "                    if stop_right and not committed:\n"
end = "                    if not committed:\n"

assert s.count(start) == 1, "코드 구조가 달라 수정하지 않았습니다."
a = s.index(start)
b = s.index(end, a)
assert "stop_then_turn(event" in s[a:b], "예상한 우회전 코드가 아닙니다."

new = """                    if stop_right and not committed:
                        permitted = bool(ready and route_valid and not motion.fault)
                        right_green_priority = False
                        event['right_entry_policy'] = 'signal_independent_right'
                        if permitted:
                            event['right_stop_released'] = True
                        self.signal_observations.clear()
                        self.core.observe_signal('GREEN' if permitted else 'RED', 1., True,
                                                 ros_now, now, ros_now)
"""

result = s[:a] + new + s[b:]
ast.parse(result)

backup = p.with_name(p.name + ".before_signal_independent_right")
if not backup.exists():
    shutil.copy2(p, backup)

p.write_text(result)
print("네 번째 우회전: 신호·정차 대기 없이 진행하도록 수정 완료")
PY
