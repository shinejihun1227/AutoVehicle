<launch>
  <!-- Fixed competition route + curvature Pure Pursuit + camera-only signal gate.
       Turn direction comes from the route geometry at a measured stop line;
       MGeo signal/intersection associations are not loaded in this profile. -->
  <arg name="workspace_path" default="$(env HOME)/morai_ws" />
  <arg name="path_file" default="$(arg workspace_path)/data/routes/2026_molit_comp_global_path.txt" />
  <arg name="signal_config_file" default="$(arg workspace_path)/config/curvature_signal.yaml" />
  <arg name="enable_control" default="false" />
  <arg name="enable_camera_dashboard" default="true" />
  <arg name="camera_dashboard_port" default="8765" />
  <arg name="bind_ip" default="0.0.0.0" />
  <arg name="morai_host_ip" default="192.168.0.147" />
  <arg name="gps_port" default="3001" />
  <arg name="imu_port" default="4001" />
  <arg name="ego_status_port" default="1911" />
  <arg name="control_remote_port" default="9093" />
  <arg name="control_source_port" default="9094" />

  <arg name="max_speed_kph" default="30.0" />
  <arg name="lateral_accel_limit_mps2" default="1.0" />
  <arg name="max_accel_mps2" default="1.0" />
  <arg name="max_decel_mps2" default="1.5" />
  <arg name="speed_kp" default="0.8" />
  <arg name="speed_ki" default="0.05" />
  <arg name="speed_integral_limit_kph_s" default="10.8" />
  <arg name="speed_error_deadband_kph" default="0.1" />
  <arg name="lookahead_min_m" default="4.0" />
  <arg name="lookahead_gain" default="0.35" />
  <arg name="lookahead_max_m" default="12.0" />
  <arg name="lookahead_tight_min_m" default="2.2" />
  <arg name="lookahead_curvature_gain" default="6.0" />
  <arg name="steering_feedforward_weight" default="0.35" />
  <arg name="max_steering_rate_rad_s" default="0.5" />
  <arg name="wheelbase_m" default="3.0" />
  <arg name="max_steering_rad" default="0.6981317008" />
  <arg name="steering_sign" default="1.0" />

  <arg name="lane_info_port" default="1101" />
  <arg name="yolo_port" default="1131" />
  <arg name="lane_info_device" default="auto" />
  <arg name="lane_info_every" default="1" />
  <arg name="lane_info_timeout_s" default="0.6" />
  <arg name="lane_min_confidence" default="0.45" />
  <arg name="lane_info_checkpoint" default="$(find camera_perception)/models/highway_best.pt" />
  <arg name="lane_info_cam_set" default="$(find camera_perception)/lane/cam_set.json" />
  <arg name="stopline_front_reference_offset_m" default="3.845" />
  <arg name="stopline_hold_distance_m" default="0.5" />
  <arg name="stopline_planning_decel_mps2" default="1.0" />
  <arg name="stopline_approach_speed_kph" default="30.0" />
  <arg name="stopline_cap_release_after_m" default="5.0" />
  <arg name="stopline_cap_max_detection_range_m" default="60.0" />
  <arg name="stopline_cap_min_confidence" default="0.55" />
  <arg name="right_on_green" default="true" />

  <!-- Start only localization and the UDP bridge from the common launch.
       The bridge always receives the FINAL /ctrl_cmd, never the nominal command. -->
  <include file="$(find morai_bringup)/launch/morai_udp_ekf_purepursuit.launch">
    <arg name="workspace_path" value="$(arg workspace_path)" />
    <arg name="path_file" value="$(arg path_file)" />
    <arg name="enable_purepursuit" value="false" />
    <arg name="enable_control" value="$(arg enable_control)" />
    <arg name="bind_ip" value="$(arg bind_ip)" />
    <arg name="morai_host_ip" value="$(arg morai_host_ip)" />
    <arg name="gps_port" value="$(arg gps_port)" />
    <arg name="imu_port" value="$(arg imu_port)" />
    <arg name="ego_status_port" value="$(arg ego_status_port)" />
    <arg name="control_remote_port" value="$(arg control_remote_port)" />
    <arg name="control_source_port" value="$(arg control_source_port)" />
    <arg name="max_steering_rad" value="$(arg max_steering_rad)" />
  </include>

  <!-- Keep nominal ROS output available in monitor mode; enable_control gates UDP only. -->
  <node pkg="curvature_speed_purepursuit" type="curvature_speed_purepursuit_node.py"
        name="curvature_speed_purepursuit" output="screen">
    <param name="path_file" value="$(arg path_file)" />
    <param name="pose_topic" value="/localization/odometry" />
    <param name="command_topic" value="/control/ctrl_cmd" />
    <param name="publish_command" value="true" />
    <param name="stopline_topic" value="/perception/camera/stopline" />
    <param name="stopline_speed_cap_enabled" value="true" />
    <param name="stopline_approach_speed_kph" value="$(arg stopline_approach_speed_kph)" />
    <param name="stopline_cap_release_after_m" value="$(arg stopline_cap_release_after_m)" />
    <param name="stopline_cap_max_detection_range_m" value="$(arg stopline_cap_max_detection_range_m)" />
    <param name="stopline_cap_min_confidence" value="$(arg stopline_cap_min_confidence)" />
    <param name="longl_cmd_type" value="1" />
    <param name="pose_timeout_sec" value="0.5" />
    <param name="max_speed_kph" value="$(arg max_speed_kph)" />
    <param name="lateral_accel_limit_mps2" value="$(arg lateral_accel_limit_mps2)" />
    <param name="max_accel_mps2" value="$(arg max_accel_mps2)" />
    <param name="max_decel_mps2" value="$(arg max_decel_mps2)" />
    <param name="speed_kp" value="$(arg speed_kp)" />
    <param name="speed_ki" value="$(arg speed_ki)" />
    <param name="speed_integral_limit_kph_s" value="$(arg speed_integral_limit_kph_s)" />
    <param name="speed_error_deadband_kph" value="$(arg speed_error_deadband_kph)" />
    <param name="lookahead_min_m" value="$(arg lookahead_min_m)" />
    <param name="lookahead_gain" value="$(arg lookahead_gain)" />
    <param name="lookahead_max_m" value="$(arg lookahead_max_m)" />
    <param name="lookahead_tight_min_m" value="$(arg lookahead_tight_min_m)" />
    <param name="lookahead_curvature_gain" value="$(arg lookahead_curvature_gain)" />
    <param name="steering_feedforward_weight" value="$(arg steering_feedforward_weight)" />
    <param name="max_steering_rate_rad_s" value="$(arg max_steering_rate_rad_s)" />
    <param name="wheelbase_m" value="$(arg wheelbase_m)" />
    <param name="max_steering_rad" value="$(arg max_steering_rad)" />
    <param name="steering_sign" value="$(arg steering_sign)" />
  </node>

  <!-- The real_lane model supplies stop-line observations, not steering. -->
  <node pkg="camera_perception" type="highway_lane_camera_node.py" name="highway_lane_camera"
        output="screen" args="--ip $(arg bind_ip) --port $(arg lane_info_port) --checkpoint $(arg lane_info_checkpoint) --cam-set $(arg lane_info_cam_set) --device $(arg lane_info_device) --every $(arg lane_info_every) --topic /perception/camera/lane_info_raw">
    <env name="MORAI_CAMERA_DEBUG" value="$(arg enable_camera_dashboard)" />
  </node>
  <node if="$(arg enable_camera_dashboard)" pkg="camera_perception" type="camera_debug_dashboard.py"
        name="camera_debug_dashboard" output="screen">
    <param name="port" value="$(arg camera_dashboard_port)" />
  </node>
  <node pkg="camera_perception" type="lane_info_contract_node.py" name="lane_info_contract" output="screen">
    <param name="timeout_sec" value="$(arg lane_info_timeout_s)" />
    <param name="min_confidence" value="$(arg lane_min_confidence)" />
  </node>
  <include file="$(find camera_perception)/launch/camera_perception.launch">
    <arg name="camera_ip" value="$(arg bind_ip)" />
    <arg name="enable_lane" value="false" />
    <arg name="enable_yolo" value="true" />
    <arg name="enable_debug_images" value="$(arg enable_camera_dashboard)" />
    <arg name="yolo_port" value="$(arg yolo_port)" />
    <arg name="enable_highway_gate" value="false" />
    <arg name="enable_pedestrian_crossing" value="false" />
    <arg name="enable_intersection_detection" value="false" />
  </include>

  <!-- One camera-only signal/stop-line overlay. A stop line without a fresh,
       recognized CAM4 signal is ignored; the curvature route remains active. -->
  <node pkg="turn_signal_controller" type="maneuver_fusion_node.py"
        name="curvature_signal_controller" output="screen">
    <rosparam file="$(arg signal_config_file)" command="load" />
    <rosparam param="maneuvers">[]</rosparam>
    <param name="path_file" value="$(arg path_file)" />
    <param name="nominal_command_topic" value="/control/ctrl_cmd" />
    <param name="output_command_topic" value="/ctrl_cmd" />
    <param name="signal_topic" value="/perception/traffic_light/directional_state" />
    <param name="signal_objects_topic" value="/detection/traffic_light" />
    <param name="stopline_topic" value="/perception/camera/stopline" />
    <param name="odometry_topic" value="/localization/odometry" />
    <param name="reference_path_topic" value="/experimental/curvature_reference_path" />
    <param name="require_route_signal_context" value="false" />
    <param name="stopline_requires_detected_signal" value="true" />
    <param name="require_reference_path_match" value="true" />
    <param name="require_fresh_camera_stream" value="false" />
    <param name="require_sensor_quality" value="false" />
    <param name="require_fresh_safety" value="false" />
    <!-- Isolate optional input from old safety publishers in the same ROS master. -->
    <param name="safety_topic" value="/curvature_signal/unused_external_safety" />
    <param name="allow_blackout_lane_corridor" value="false" />
    <param name="test_without_turn_signals" value="true" />
    <param name="lamp_output_enabled" value="false" />
    <param name="right_on_green" value="$(arg right_on_green)" />
    <param name="max_speed_kph" value="$(arg max_speed_kph)" />
    <param name="lateral_accel_limit_mps2" value="$(arg lateral_accel_limit_mps2)" />
    <param name="front_reference_offset_m" value="$(arg stopline_front_reference_offset_m)" />
    <param name="front_axle_offset_m" value="$(arg wheelbase_m)" />
    <param name="hold_distance_m" value="$(arg stopline_hold_distance_m)" />
    <param name="max_decel_mps2" value="$(arg max_decel_mps2)" />
    <param name="planning_decel_mps2" value="$(arg stopline_planning_decel_mps2)" />
  </node>
</launch>
